  title     = {Natural Synthetic Anomalies for Self-supervised Anomaly Detection
               and Localization},
  booktitle = {{ECCV} {(31)}},
  series    = {Lecture Notes in Computer Science},
  volume    = {13691},
  pages     = {474--489},
  publisher = {Springer},
  year      = {2022},
  doi = {10.1007/978-3-031-19821-2\_27},
