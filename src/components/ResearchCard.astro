---
import type { CollectionEntry } from 'astro:content';
import ResearchArt from './ResearchArt.astro';
import Icon from './Icon.astro';
import { url } from '../lib/urls';
interface Props { project: CollectionEntry<'research'>; featured?: boolean; headingLevel?: 2 | 3; }
const { project, featured = false, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<article class:list={['research-card', { 'research-feature': featured }]}>
  <a class="art-link" href={url(`/research/${project.id}/`)} tabindex="-1" aria-hidden="true">
    <ResearchArt variant={project.data.illustration} />
  </a>
  <div class="research-card-copy">
    <p class="field">{project.data.field} · {project.data.period || project.data.year}</p>
    <Heading><a href={url(`/research/${project.id}/`)}>{project.data.shortTitle}</a></Heading>
    <p class="research-description">{project.data.description}</p>
    <a class="text-link" href={url(`/research/${project.id}/`)} aria-label={`Explore project: ${project.data.shortTitle}`}>Explore project<Icon /></a>
  </div>
</article>
