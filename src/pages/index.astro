---
import Layout from '../layouts/Layout.astro';
import ResearchPaperCard from '../components/ResearchPaperCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { homePage } from '../data/pages';
import { getResearchPapers, getWriting } from '../lib/collections';
import { url } from '../lib/urls';

const researchPapers = await getResearchPapers(true);
const writing = await getWriting(homePage.writingLimit);
---
<Layout>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">
      <span class="intro-title-line">{homePage.title[0]}</span>
      <span class="intro-title-line">{homePage.title[1]}</span>
    </h1>
    <p class="lede">{homePage.lede}</p>
    <div class="intro-actions">
      <a class="button button-primary" href={url(homePage.primaryAction.href)}>
        {homePage.primaryAction.label}<Icon />
      </a>
      <a class="text-link" href={url(homePage.secondaryAction.href)}>
        {homePage.secondaryAction.label}<Icon />
      </a>
    </div>
  </section>
  <section class="section" aria-labelledby="research-title">
    <SectionHeading
      id="research-title"
      title={homePage.sections.research.title}
      actionLabel={homePage.sections.research.actionLabel}
      href="/research/"
    />
    <div class="research-list">
      {researchPapers.map(({ publication, entry }) => (
        <ResearchPaperCard
          publication={publication}
          summary={entry.summary}
          image={entry.image}
        />
      ))}
    </div>
  </section>
  <section class="section" aria-labelledby="publications-title">
    <SectionHeading
      id="publications-title"
      title={homePage.sections.publications.title}
      actionLabel={homePage.sections.publications.actionLabel}
      href="/publications/"
    />
    <div class="publication-list">
      {homePage.publications.map(publication => (
        <article class="publication">
          <span class="publication-year">{publication.year}</span>
          <div class="publication-content">
            <h3>{publication.title}</h3>
            <p class="authors">{publication.authors}</p>
            <p class="venue">{publication.venue}</p>
            {publication.href && (
              <div class="publication-actions">
                <a href={url(publication.href)} aria-label={`View paper: ${publication.title}`}>Paper</a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section" aria-labelledby="writing-title">
    <SectionHeading
      id="writing-title"
      title={homePage.sections.writing.title}
      actionLabel={homePage.sections.writing.actionLabel}
      href="/writing/"
    />
    <ul class="writing-list">
      {writing.map(post => (
        <li>
          <a class="writing-link" href={url(`/writing/${post.id}/`)}>
            <span class="writing-title">
              {post.data.title}
              <small>{post.data.category}</small>
            </span>
            <span class="writing-date">{post.data.published.getUTCFullYear()}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
