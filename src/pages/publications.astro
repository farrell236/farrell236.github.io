---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Publication from '../components/Publication.astro';
import { profile } from '../config';
import { sectionPages } from '../data/pages';
import { getPublications } from '../lib/collections';
import Icon from '../components/Icon.astro';
import { url } from '../lib/urls';

const publications = await getPublications();
const years = [...new Set(publications.map(publication => publication.data.year))];
const page = sectionPages.publications;
---
<Layout title={page.title} description={page.metaDescription}>
  <PageHeading title={page.title} description={page.description}>
    <div class="resource-links">
      <a class="text-link" href={url(profile.links[0].href)}>
        {page.profileLinkLabel}<Icon name="arrow-up-right" />
      </a>
      <a class="text-link" href={url(profile.orcid)}>
        ORCID<Icon name="arrow-up-right" />
      </a>
    </div>
  </PageHeading>
  {years.map(year => (
    <section aria-labelledby={`year-${year}`}>
      <h2 class="year-heading" id={`year-${year}`}>{year}</h2>
      <div class="publication-list">
        {publications
          .filter(publication => publication.data.year === year)
          .map(publication => <Publication publication={publication} showYear={false} />)}
      </div>
    </section>
  ))}
</Layout>
